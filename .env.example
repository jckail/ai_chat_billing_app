# Copy to a private .env. Values below are placeholders and development defaults, not credentials.
# Settings in backend/app/core/config.py loads this file. Compose interpolates only ANTHROPIC_API_KEY;
# other service environment entries in docker-compose.yml are assigned in that file.

# FastAPI debug flag (Settings.DEBUG).
DEBUG=false

# SQLAlchemy URL for the backend and dashboard.
DATABASE_URL=sqlite:///data/billing.db

# Redis URL for the backend and dashboard.
REDIS_URL=redis://redis:6379/0

# Kafka broker list for the backend and event collector.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Anthropic key. Leave empty here; set a real key only in the private .env or the shell.
ANTHROPIC_API_KEY=

# USD price per input token (Settings.DEFAULT_INPUT_TOKEN_PRICE).
DEFAULT_INPUT_TOKEN_PRICE=0.000001

# USD price per output token (Settings.DEFAULT_OUTPUT_TOKEN_PRICE).
DEFAULT_OUTPUT_TOKEN_PRICE=0.000005

# Create React App API base URL. Compose assigns http://localhost:8000/api on the frontend service.
REACT_APP_API_URL=http://localhost:8000/api

# Bitnami Kafka image settings assigned in docker-compose.yml (not read by Settings).
KAFKA_CFG_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_CFG_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
ALLOW_PLAINTEXT_LISTENER=yes

# Bitnami ZooKeeper image setting assigned in docker-compose.yml.
ALLOW_ANONYMOUS_LOGIN=yes
